---
// src/pages/index.astro
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pick Your Poison | The Alchemist's Trial</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Plus+Jakarta+Sans:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #09070e;
        --card-bg: rgba(22, 17, 34, 0.75);
        --border-glass: rgba(168, 85, 247, 0.2);
        --gold: #f59e0b;
        --purple-glow: #a855f7;
        --green-safe: #10b981;
        --red-poison: #ef4444;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        padding: 2rem 1rem;
        background: radial-gradient(circle at 50% 10%, #1e1338 0%, var(--bg) 70%);
        color: #e5e7eb;
        font-family: 'Plus Jakarta Sans', sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        overflow-x: hidden;
      }

      /* Game Header & Stats */
      .header-container {
        text-align: center;
        max-width: 650px;
        margin-bottom: 2rem;
      }

      h1 {
        font-family: 'Cinzel', serif;
        font-size: 2.75rem;
        font-weight: 900;
        letter-spacing: 2px;
        margin: 0 0 0.5rem 0;
        background: linear-gradient(135deg, #fff 30%, #c084fc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0 0 30px rgba(192, 132, 252, 0.3);
      }

      .subtitle {
        color: #9ca3af;
        font-size: 0.95rem;
        line-height: 1.5;
        margin: 0 0 1.5rem 0;
      }

      .scoreboard {
        display: inline-flex;
        gap: 2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border-glass);
        padding: 0.6rem 1.8rem;
        border-radius: 999px;
        backdrop-filter: blur(10px);
      }

      .stat-item {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #a1a1aa;
      }

      .stat-value {
        font-family: 'Cinzel', serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--gold);
        margin-left: 0.3rem;
      }

      /* Alchemist Shelf */
      .shelf-wrapper {
        width: 100%;
        max-width: 950px;
        position: relative;
        margin-top: 1rem;
      }

      .shelf-base {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 14px;
        background: linear-gradient(180deg, #2e263d 0%, #15111c 100%);
        border-radius: 4px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.8), 0 0 15px rgba(168, 85, 247, 0.15);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        z-index: 1;
      }

      .bottles-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        padding-bottom: 14px;
        position: relative;
        z-index: 2;
      }

      /* Potion Card */
      .vial-card {
        background: var(--card-bg);
        border: 1px solid var(--border-glass);
        border-radius: 16px 16px 0 0;
        padding: 1.75rem 1.25rem;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        backdrop-filter: blur(12px);
        position: relative;
        overflow: hidden;
      }

      .vial-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 50% 30%, rgba(168, 85, 247, 0.15), transparent 70%);
        opacity: 0;
        transition: opacity 0.3s;
      }

      .vial-card:hover {
        transform: translateY(-8px);
        border-color: rgba(192, 132, 252, 0.6);
        box-shadow: 0 12px 30px rgba(168, 85, 247, 0.25);
      }

      .vial-card:hover::before {
        opacity: 1;
      }

      /* Flask SVG Graphic */
      .flask-svg {
        width: 85px;
        height: 110px;
        filter: drop-shadow(0 0 12px var(--glow-color, rgba(168, 85, 247, 0.4)));
        transition: transform 0.3s ease;
      }

      .vial-card:hover .flask-svg {
        transform: scale(1.06);
      }

      .vial-id-badge {
        font-family: 'Cinzel', serif;
        font-size: 0.85rem;
        font-weight: 700;
        color: #d8b4fe;
        background: rgba(168, 85, 247, 0.15);
        border: 1px solid rgba(168, 85, 247, 0.3);
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
        margin-top: 1rem;
        letter-spacing: 1px;
      }

      .vial-name {
        font-family: 'Cinzel', serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: #faf5ff;
        margin: 0.6rem 0 0.8rem 0;
      }

      .inscription-box {
        font-size: 0.9rem;
        font-style: italic;
        color: #cbd5e1;
        line-height: 1.5;
        background: rgba(0, 0, 0, 0.3);
        border: 1px dashed rgba(255, 255, 255, 0.1);
        padding: 0.75rem;
        border-radius: 8px;
        width: 100%;
      }

      /* Feedback & Results Modal/Banner */
      .result-banner {
        max-width: 650px;
        width: 100%;
        margin-top: 2rem;
        padding: 1.25rem 1.75rem;
        border-radius: 12px;
        display: none;
        animation: slideUp 0.3s ease forwards;
        text-align: center;
      }

      .result-banner.correct {
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.4);
        color: #6ee7b7;
      }

      .result-banner.wrong {
        background: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.4);
        color: #fca5a5;
      }

      .result-title {
        font-family: 'Cinzel', serif;
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 0.4rem;
      }

      .result-desc {
        font-size: 0.95rem;
        color: #e5e7eb;
        line-height: 1.5;
      }

      #next-btn {
        margin-top: 1.5rem;
        padding: 0.85rem 2.2rem;
        background: linear-gradient(135deg, #a855f7 0%, #7e22ce 100%);
        color: white;
        font-family: 'Cinzel', serif;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 1px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        cursor: pointer;
        box-shadow: 0 4px 20px rgba(168, 85, 247, 0.4);
        transition: all 0.2s;
        display: none;
      }

      #next-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 25px rgba(168, 85, 247, 0.6);
      }

      /* Loader */
      .cauldron-loader {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 300px;
        gap: 1rem;
      }

      .spinner {
        width: 45px;
        height: 45px;
        border: 3px solid rgba(168, 85, 247, 0.2);
        border-top-color: #c084fc;
        border-radius: 50%;
        animation: spin 0.9s linear infinite;
      }

      @keyframes spin { to { transform: rotate(360deg); } }
      @keyframes slideUp {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @media (max-width: 768px) {
        .bottles-grid { grid-template-columns: 1fr; gap: 1rem; }
        .vial-card { border-radius: 12px; }
        .shelf-base { display: none; }
        h1 { font-size: 2.1rem; }
      }
    </style>
  </head>
  <body>
    <div class="header-container">
      <h1>PICK YOUR POISON</h1>
      <p class="subtitle">
        Two tinctures speak absolute truth. One draught contains lethal poison and tells a lie. Identify and neutralize the lie.
      </p>
      
      <div class="scoreboard">
        <div class="stat-item">Streak <span class="stat-value" id="current-streak">0</span></div>
        <div class="stat-item">Record <span class="stat-value" id="best-streak">0</span></div>
      </div>
    </div>

    <div class="shelf-wrapper">
      <div id="shelf-content">
        <div class="cauldron-loader">
          <div class="spinner"></div>
          <span style="font-family: 'Cinzel', serif; color: #a1a1aa; letter-spacing: 1px;">Brewing Concoctions...</span>
        </div>
      </div>
      <div class="shelf-base"></div>
    </div>

    <div id="result-banner" class="result-banner">
      <div id="result-title" class="result-title"></div>
      <div id="result-desc" class="result-desc"></div>
    </div>

    <button id="next-btn">Brew Next Batch</button>

    <script>
      // Sound Synthesizer via Web Audio API (Zero downloads needed)
      const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      
      function playTone(freq: number, type: OscillatorType, duration: number, delay = 0) {
        setTimeout(() => {
          try {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = type;
            osc.frequency.value = freq;
            gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + duration);
          } catch(e) {}
        }, delay * 1000);
      }

      function playSuccessSound() {
        playTone(523.25, 'sine', 0.15, 0);       // C5
        playTone(659.25, 'sine', 0.15, 0.1);     // E5
        playTone(783.99, 'sine', 0.35, 0.2);     // G5
        playTone(1046.50, 'triangle', 0.5, 0.3); // C6
      }

      function playFailSound() {
        playTone(311.13, 'sawtooth', 0.2, 0);     // Eb4
        playTone(293.66, 'sawtooth', 0.4, 0.15);  // D4
        playTone(207.65, 'sawtooth', 0.6, 0.3);   // G#3
      }

      // Bottle SVG Color Themes (Emerald, Amethyst, Amber)
      const THEMES = [
        { color: '#10b981', glow: 'rgba(16, 185, 129, 0.4)', grad1: '#34d399', grad2: '#065f46' },
        { color: '#a855f7', glow: 'rgba(168, 85, 247, 0.4)', grad1: '#c084fc', grad2: '#581c87' },
        { color: '#f59e0b', glow: 'rgba(245, 158, 11, 0.4)', grad1: '#fbbf24', grad2: '#78350f' }
      ];

      function generateBottleSVG(index: number) {
        const t = THEMES[index % THEMES.length];
        return `
          <svg class="flask-svg" style="--glow-color: ${t.glow}" viewBox="0 0 100 130" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Cork -->
            <rect x="42" y="8" width="16" height="12" rx="2" fill="#8d5b36" stroke="#451a03" stroke-width="2"/>
            <!-- Flask Neck & Lip -->
            <path d="M38 18H62V24C62 24 56 26 56 34V42L78 88C86 104 74 122 50 122C26 122 14 104 22 88L44 42V34C44 26 38 24 38 24V18Z" 
                  fill="rgba(255, 255, 255, 0.05)" stroke="rgba(255, 255, 255, 0.4)" stroke-width="3"/>
            <!-- Liquid -->
            <path d="M26 82L44 46H56L74 82C84 100 72 116 50 116C28 116 16 100 26 82Z" fill="url(#grad-${index})"/>
            <!-- Reflection Highlight -->
            <path d="M28 80L44 48C44 48 40 56 32 78C30 84 32 94 36 98" stroke="rgba(255, 255, 255, 0.6)" stroke-width="2" stroke-linecap="round"/>
            <defs>
              <linearGradient id="grad-${index}" x1="50" y1="46" x2="50" y2="116" gradientUnits="userSpaceOnUse">
                <stop stop-color="${t.grad1}"/>
                <stop offset="1" stop-color="${t.grad2}"/>
              </linearGradient>
            </defs>
          </svg>
        `;
      }

      // Game Logic & Buffer Queue
      let puzzleQueue: any[] = [];
      let currentPuzzle: any = null;
      let isFetching = false;
      let isLocked = false;
      let streak = 0;
      let bestStreak = parseInt(localStorage.getItem('alchemist_best') || '0', 10);

      const shelf = document.getElementById('shelf-content')!;
      const banner = document.getElementById('result-banner')!;
      const resultTitle = document.getElementById('result-title')!;
      const resultDesc = document.getElementById('result-desc')!;
      const nextBtn = document.getElementById('next-btn')!;
      const currentStreakEl = document.getElementById('current-streak')!;
      const bestStreakEl = document.getElementById('best-streak')!;

      bestStreakEl.textContent = bestStreak.toString();

      async function replenishBuffer() {
        if (isFetching || puzzleQueue.length >= 3) return;
        isFetching = true;
        try {
          const res = await fetch('/api/generate-puzzle');
          const data = await res.json();
          if (data.puzzles?.length) {
            puzzleQueue.push(...data.puzzles);
            if (!currentPuzzle) nextRound();
          }
        } catch (e) {
          console.error('Alchemist buffer fetch failed', e);
        } finally {
          isFetching = false;
        }
      }

      function nextRound() {
        if (puzzleQueue.length === 0) {
          shelf.innerHTML = `
            <div class="cauldron-loader">
              <div class="spinner"></div>
              <span style="font-family: 'Cinzel', serif; color: #a1a1aa;">Distilling draughts...</span>
            </div>
          `;
          replenishBuffer();
          return;
        }

        currentPuzzle = puzzleQueue.shift();
        isLocked = false;
        banner.style.display = 'none';
        nextBtn.style.display = 'none';

        shelf.innerHTML = `
          <div class="bottles-grid">
            ${currentPuzzle.vials.map((v: any, i: number) => `
              <div class="vial-card" data-id="${v.id}">
                ${generateBottleSVG(i)}
                <div class="vial-id-badge">DRAUGHT ${v.id}</div>
                <div class="vial-name">${v.name}</div>
                <div class="inscription-box">"${v.inscription}"</div>
              </div>
            `).join('')}
          </div>
        `;

        document.querySelectorAll('.vial-card').forEach(card => {
          card.addEventListener('click', () => {
            const selected = card.getAttribute('data-id');
            handleSelection(selected);
          });
        });

        replenishBuffer();
      }

      function handleSelection(selectedId: string | null) {
        if (isLocked || !currentPuzzle || !selectedId) return;
        isLocked = true;

        if (audioCtx.state === 'suspended') audioCtx.resume();

        const isCorrect = (selectedId === currentPuzzle.poison_id);

        if (isCorrect) {
          playSuccessSound();
          streak++;
          if (streak > bestStreak) {
            bestStreak = streak;
            localStorage.setItem('alchemist_best', bestStreak.toString());
            bestStreakEl.textContent = bestStreak.toString();
          }
          currentStreakEl.textContent = streak.toString();

          banner.className = 'result-banner correct';
          resultTitle.textContent = '✨ POISON NEUTRALIZED!';
          resultDesc.textContent = `Brilliant deduction. ${currentPuzzle.explanation}`;
        } else {
          playFailSound();
          streak = 0;
          currentStreakEl.textContent = '0';

          banner.className = 'result-banner wrong';
          resultTitle.textContent = '☠️ FATAL ERROR!';
          resultDesc.textContent = `You drank a pure tonic! Draught ${currentPuzzle.poison_id} was the poison.`;
        }

        banner.style.display = 'block';
        nextBtn.style.display = 'inline-block';
      }

      nextBtn.addEventListener('click', nextRound);
      replenishBuffer();
    </script>
  </body>
</html>